# Copy to .env and uncomment the entries your deployment needs.
# Explicit code or CLI overrides take precedence over process environment,
# then .env, then defaults. Capacity entries apply to each active role domain.

# Set in the process environment. Defaults to .env in the current directory.
# An empty value disables env-file loading.
# C2_ENV_FILE=.env

# Relay anchor for registration and name resolution. Unset for direct IPC.
# C2_RELAY_ANCHOR_ADDRESS=http://127.0.0.1:8080

# Final Unix endpoint directory. Defaults to /tmp/c2-v3-<uidhex>.
# Provision a custom directory yourself. Windows uses TokenUser-scoped pipes.
# C2_IPC_ROOT=/run/user/1000/myapp

# Memory per domain, in bytes. Default 16 GiB. Zero disables positive memory
# allocations and all new business calls in that domain.
# C2_MEMORY_BUDGET_BYTES=17179869184

# File spill per domain, in bytes. Default 16 GiB. Zero disables file spill.
# C2_FILE_SPILL_BUDGET_BYTES=17179869184

# Outstanding calls per domain. Defaults to zero if memory is zero, else
# max(64, floor(memory_bytes / 65536)), or 262144 at 16 GiB. Zero closes admission.
# C2_CALL_MAX_OUTSTANDING=262144

# Maximum single payload carried by a Host, in bytes. Default 16 GiB. Must be positive.
# C2_MAX_PAYLOAD_SIZE=17179869184

# Host execution workers. Defaults to host parallelism clamped to 4–64,
# with fallback parallelism 4. Explicit values must be positive.
# C2_MAX_EXECUTION_WORKERS=8

# Relay loopback control listen address. Default 127.0.0.1:8080.
# C2_RELAY_BIND=127.0.0.1:8080

# Optional relay business edge listen address. Non-loopback defaults to TLS.
# C2_RELAY_EDGE_BIND=0.0.0.0:8443

# Explicit edge TLS certificate chain and private key (PEM). Supply both.
# C2_RELAY_TLS_CERT=/path/to/fullchain.pem
# C2_RELAY_TLS_KEY=/path/to/privkey.pem

# Enable persistent self-signed edge TLS, including on a loopback edge bind.
# C2_RELAY_TLS_AUTO=false

# Comma-separated additional DNS names or IP addresses for automatic edge TLS.
# C2_RELAY_TLS_SAN=relay.example.com,10.0.0.5

# Private directory holding generated relay TLS state. Default ~/.c3-relay.
# C2_RELAY_STATE_DIR=/path/to/relay-state

# Explicitly allow a plaintext non-loopback edge listener.
# C2_RELAY_INSECURE_PLAINTEXT=false

# Relay client TLS trust overrides (mutually exclusive).
# C2_RELAY_CA_CERT=/path/to/ca.pem
# C2_RELAY_CERT_SHA256=sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Relay mesh identity. Generated when unset.
# C2_RELAY_ID=relay-a

# Relay URL announced to mesh peers. Derived from the actual bind address when unset.
# C2_RELAY_ADVERTISE_URL=http://relay-a.example.com:8080

# Comma-separated seed relay URLs. Empty by default.
# C2_RELAY_SEEDS=http://127.0.0.1:8081

# Private iroh bridge URL and separate admission and cluster credentials.
# C2_RELAY_BRIDGE=https://bridge.example.org:8443?quic=off
# C2_RELAY_BRIDGE_TOKEN=<bridge-token>
# C2_RELAY_CLUSTER_SECRET=<cluster-secret>

# c3 bridge. Omit the certificate and token to generate and persist them.
# C2_BRIDGE_BIND=0.0.0.0:8443
# C2_BRIDGE_QUIC_BIND=0.0.0.0:7842
# C2_BRIDGE_TLS_CERT=/path/to/fullchain.pem
# C2_BRIDGE_TLS_KEY=/path/to/privkey.pem
# C2_BRIDGE_STATE_DIR=/path/to/bridge-state
# C2_BRIDGE_TOKEN=<bridge-token>

# Honor the process HTTP proxy settings for relay traffic. Default false.
# C2_RELAY_USE_PROXY=false
