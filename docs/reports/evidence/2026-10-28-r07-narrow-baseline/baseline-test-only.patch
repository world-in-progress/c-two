+    // R07 baseline only: real native stream and production send/write_complete.
+    // The dependency hook changes poll_flush only, after native write_all.
+    async fn r07_assert_published_frame_not_recycled(flush_fault: u8) {
+        let pool = small_response_pool("r07publish");
+        let prepared = try_prepare_shm_response(&pool, 1024, 8192, |dst| {
+            dst.fill(0xA5); Ok(())
+        }).unwrap().unwrap();
+        let original = prepared.shm_allocation().unwrap();
+        let (mut peer, stream) = LocalStream::pair().await.unwrap();
+        let (_reader, mut half) = stream.into_split();
+        half.r07_set_flush_fault(flush_fault);
+        let writer = Arc::new(Mutex::new(half));
+        let result;
+        let received;
+        if flush_fault == 1 {
+            (result, received) = tokio::join!(
+                send_prepared_shm_response(&pool, &writer, 73, prepared),
+                read_reply_frame(&mut peer),
+            );
+        } else {
+            let mut send = Box::pin(send_prepared_shm_response(&pool, &writer, 73, prepared));
+            received = tokio::select! {
+                biased;
+                result = &mut send => panic!("flush must remain pending: {result:?}"),
+                frame = read_reply_frame(&mut peer) => frame,
+            };
+            tokio::time::pause();
+            tokio::time::advance(Duration::from_secs(31)).await;
+            result = send.await;
+        }
+        let (request_id, flags, payload) = received;
+        assert_eq!(request_id, 73);
+        assert_eq!(flags, FLAG_RESPONSE | FLAG_REPLY_V2 | FLAG_BUDDY);
+        let (wire, _) = decode_buddy_payload(&payload).unwrap();
+        assert_eq!(wire.allocation_id, original.allocation_id);
+        assert_eq!(wire.offset, original.offset);
+        let error = result.expect_err("flush failure/expiry must remain an error");
+        let live_after_error = pool.read().stats().alloc_count;
+        let mut next = pool.inner.write().alloc_shm_handle(8192).unwrap();
+        let replacement = next.shm_allocation().unwrap();
+        let reused = replacement.seg_idx == original.seg_idx
+            && replacement.offset == original.offset
+            && replacement.allocation_id != original.allocation_id;
+        pool.read().handle_slice_mut(&mut next).fill(0x5A);
+        eprintln!("R07_BASELINE flush_fault={flush_fault} complete_frame_received=true error={error} live_after_error={live_after_error} same_address_reused={reused} old_id={} new_id={}", original.allocation_id, replacement.allocation_id);
+        pool.inner.write().release_handle(next).unwrap();
+        drop((writer, peer));
+        // Correct contract: publication retains the original allocation for peer release.
+        // Current baseline fails here, after its isolated replacement is cleaned.
+        assert_eq!(live_after_error, 1, "published SHM was freed locally after flush failed");
+        assert!(!reused, "peer-visible coordinates now address a new allocation");
+    }
+
+    #[tokio::test]
+    async fn r07_baseline_full_frame_flush_failure_must_not_free_published_shm() {
+        r07_assert_published_frame_not_recycled(1).await;
+    }
+
+    #[tokio::test]
+    async fn r07_baseline_full_frame_flush_timeout_must_not_free_published_shm() {
+        r07_assert_published_frame_not_recycled(2).await;
+    }
+
