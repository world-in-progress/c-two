+#[cfg(test)]
+mod r07_narrow_baseline {
+    use super::*;
+    use std::{cell::Cell, sync::Arc};
+    use c2_mem::{MemPool, PoolConfig};
+    use c2_wire::chunk::ReassemblyBacking;
+    use parking_lot::RwLock;
+
+    fn pool(label: &str) -> MemPool {
+        MemPool::new_with_prefix(PoolConfig {
+            segment_size: 64 * 1024, min_block_size: 4096,
+            max_segments: 1, max_dedicated_segments: 1,
+            ..PoolConfig::default()
+        }, format!("/c2r07n{}-{label}", std::process::id()))
+    }
+
+    #[test]
+    fn r07_baseline_failed_held_release_keeps_native_retry_obligation() {
+        let pool = Arc::new(RwLock::new(pool("original")));
+        let budget = pool.read().budget().unwrap().clone();
+        let backing = ReassemblyBacking::admit(Arc::clone(&pool), 1, 512).unwrap();
+        let mut held = HeldResponse::from_response_lease(ResponseLease::new(
+            c2_ipc::ResponseData::Handle(backing),
+        )).unwrap();
+        let original = std::mem::replace(&mut *pool.write(), self::pool("foreign"));
+        let calls = Cell::new(0);
+        let first = held.invalidate_then_release(|| { calls.set(calls.get()+1); Ok(()) });
+        assert!(first.is_err());
+        *pool.write() = original;
+        let second = held.invalidate_then_release(|| { calls.set(calls.get()+1); Ok(()) });
+        let remaining = pool.read().stats().alloc_count;
+        let charge = budget.snapshot().reassembly.used_bytes;
+        eprintln!("R07_HELD_BASELINE first_error={} second_ok={} invalidations={} remaining={} reassembly_charge={}", first.unwrap_err(), second.is_ok(), calls.get(), remaining, charge);
+        drop(held);
+        pool.write().destroy(); // This task-owned pool only; no repair of the foreign authority.
+        assert!(second.is_ok());
+        assert_eq!(calls.get(), 1, "invalidation must not replay");
+        assert_eq!(remaining, 0, "second release reported success with its old allocation still live");
+        assert_eq!(charge, 0, "successful retry must refund its original reservation");
+    }
+
+    #[test]
+    fn r07_baseline_invalidation_panic_does_not_replay_user_callback() {
+        let mut held = HeldResponse::from_owned_bytes(vec![1]);
+        let calls = Cell::new(0);
+        assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            held.invalidate_then_release(|| { calls.set(calls.get()+1); panic!("R07 injected invalidator panic"); })
+        })).is_err());
+        held.invalidate_then_release(|| { calls.set(calls.get()+1); Ok(()) }).unwrap();
+        eprintln!("R07_INVALIDATOR_BASELINE callback_count={}", calls.get());
+        assert_eq!(calls.get(), 1, "caught invalidator panic must not replay user code");
+    }
+}
